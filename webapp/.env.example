# PostgreSQL connection for the Rudro Khobor database.
#
# Local default (Homebrew PostgreSQL on /tmp socket, trust auth):
DATABASE_URL=postgresql://localhost:5432/rudro_khobor

# ---------------------------------------------------------------------------
# Authentication / admin sessions
# ---------------------------------------------------------------------------

# Lifetime of an admin session in days (default 30). Session identifiers are
# random high-entropy tokens issued at login; only their SHA-256 hash is
# stored in the sessions table.
# SESSION_TTL_DAYS=30

# Force Secure on/off for the session cookie. Defaults to the value of
# NODE_ENV (Secure on in production, off in dev). Keep on in production.
# SESSION_COOKIE_SECURE=true

# CSRF defense-in-depth for admin mutations: an Origin header must match this
# allowlist or the request Host. Comma-separated list of exact origins
# (e.g. https://rudrokhobor.example.com). Empty = only the request Host is
# accepted (same-origin).
# AUTH_ALLOWED_ORIGINS=

# Password used to seed the admin@rudrokhobor.dev account on a FRESH
# database (npm run db:seed). Never set in production unless you are
# seeding a brand-new deployment. For an existing database, use:
#   ADMIN_PASSWORD="..." npm run db:set-admin-password
# SEED_ADMIN_PASSWORD=